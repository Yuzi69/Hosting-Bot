BOT_TOKEN=8757684358:AAEpwd4U2OD3SBziDkcxkjtao7LWIiqt25I

# Public URL(s) users will use to reach deployed sites (no trailing slash).
# PUBLIC_BASE_URL = single/default domain, used as fallback.
PUBLIC_BASE_URL=https://docker-ubuntu-desktop-production-d06a.up.railway.app

# FREE_DOMAINS = comma-separated list of domains users can pick from when
# deploying (e.g. if you've added multiple Railway domains pointing at the
# same service/port). If left empty, PUBLIC_BASE_URL is used automatically
# and users won't be asked to choose.
# Example: FREE_DOMAINS=https://domain-one.up.railway.app,https://domain-two.up.railway.app
FREE_DOMAINS=

HOSTED_APPS_DIR=/var/www/hosted
DATA_FILE=data/projects.json

# Port the aiohttp webserver.py listens on (put behind nginx/port-80 if you want).
WEB_PORT=8080

# First port used when assigning ports to Node/Java apps (auto-increments).
BASE_PORT=4000

# Optional: comma-separated Telegram user IDs allowed to use this bot.
# Leave EMPTY to make the bot public — anyone who finds it can deploy.
ALLOWED_USER_IDS=

# Comma-separated Telegram user IDs who can see the /admin panel
# (lists every user's deployed projects + URLs). Get your ID from @userinfobot.
ADMIN_USER_IDS=7852699226
