{
  "systemSetup": [
    {
      "name": "Install pip",
      "command": "pip install --upgrade pip"
    }
  ],
  "templateName": "custom",
  "projectDependencies": [
    {
      "name": "Install Python dependencies",
      "command": "pip install -r requirements.txt"
    }
  ],
  "codeChecks": [
    {
      "name": "Lint Python code",
      "command": "flake8 bot.py webserver.py deploy.py store.py"
    }
  ],
  "buildSteps": [],
  "runStep": [
    {
      "name": "Start services with PM2",
      "command": "pm2 start bot.py --name hosting-bot && pm2 start webserver.py --name hosting-web --port 8080",
      "port": "8080"
    }
  ],
  "deploySteps": [
    {
      "name": "Save PM2 configuration",
      "command": "pm2 save"
    },
    {
      "name": "Setup PM2 startup",
      "command": "pm2 startup"
    }
  ],
  "cleanupFiles": [
    "*/node_modules/*",
    "*/.cache/*",
    "*.pyc",
    ".Python",
    "venv/*",
    "__pycache__/*",
    "*.egg-info/*",
    ".pytest_cache/*",
    "*.log"
  ],
  "packageManager": "pip",
  "envPaths": [
    {
      "name": "default",
      "path": ".env"
    }
  ]
}